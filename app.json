{
  "expo": {
    "name": "opac-app",
    "slug": "opac-app",
    "scheme": "opac-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf9f5"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Opac Ops",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-font"]
  }
}
